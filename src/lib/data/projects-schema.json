{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"projects": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"title": { "type": "string" },
					"subtitle": { "type": "string" },
					"year": { "type": "string" },
					"description": { "type": "string" },
					"technologies": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"category": { "type": "string" },
								"badges": {
									"type": "array",
									"items": {
										"type": "string",
										"enum": [
											"Angular",
											"Css",
											"Figma",
											"React",
											"Reactnative",
											"Shadcnui",
											"Svelte",
											"Sveltekit",
											"Tailwindcss",
											"Dotnet",
											"Entityframework",
											"Express",
											"Fastapi",
											"Hono",
											"Mediatr",
											"Nestjs",
											"Spring",
											"Springboot",
											"Sqlmodel",
											"C",
											"CSharp",
											"Cplusplus",
											"Crystal",
											"D",
											"Dart",
											"Fsharp",
											"Gleam",
											"Java",
											"Javascript",
											"Julia",
											"Ocaml",
											"Python",
											"R",
											"Reasonml",
											"Ruby",
											"Rust",
											"Typescript",
											"V",
											"Visualbasic",
											"Lodash",
											"Reactivex",
											"Zod",
											"Jest",
											"Junit5",
											"XUnitdotnet",
											"AWS",
											"Cloudflare",
											"Docker",
											"Github",
											"Githubactions",
											"GnuBash",
											"Googlecloud",
											"Kubernetes",
											"Ruff",
											"Terraform",
											"Uv",
											"Elasticsearch",
											"Mongodb",
											"Postgresql",
											"Diagramsdotnet",
											"Latex",
											"Openapiinitiative",
											"Uml",
											"Googlegemini",
											"Huggingface",
											"Matplotlib",
											"Numpy",
											"Pandas",
											"Pytorch",
											"Scikitlearn",
											"Vite",
											"Webassembly"
										]
									}
								}
							},
							"required": ["category", "badges"],
							"additionalProperties": false
						}
					},
					"buttons": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"label": { "type": "string" },
								"href": { "type": "string" },
								"icon": { "type": "string", "enum": ["Cloud", "Document", "Github"] }
							},
							"required": ["label", "href", "icon"],
							"additionalProperties": false
						}
					}
				},
				"required": ["title", "description", "technologies", "buttons"],
				"additionalProperties": false
			}
		}
	},
	"required": ["projects"],
	"additionalProperties": true
}
